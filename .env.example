# Postgres connection string. Required — Vercel's serverless functions have
# no persistent writable disk, so this can't be a local SQLite file in
# production. For local dev, point this at a local Postgres instance or a
# free hosted one (e.g. Neon).
# Local example: postgresql://postgres:yourpassword@localhost:5432/dockclock
DATABASE_URL=""

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables AI-assisted rate confirmation parsing on the "New Load" screen.
# Without it, the app falls back to a plain manual entry form — every core
# feature (arrival/departure logging, detention math, invoicing) works without it.
ANTHROPIC_API_KEY=""
