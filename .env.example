# Local SQLite database (swap provider to "postgresql" in prisma/schema.prisma for production)
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"

# Optional: enables AI-assisted rate confirmation parsing on the "New Load" screen.
# Without it, the app falls back to a plain manual entry form — every core
# feature (arrival/departure logging, detention math, invoicing) works without it.
ANTHROPIC_API_KEY=""
